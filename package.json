{
  "name": "glasspot",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:up": "docker compose -f apps/backend/docker-compose.yml --env-file apps/backend/.env up -d",
    "db:generate": "pnpm --filter @glasspot/backend db:generate",
    "db:migrate": "pnpm --filter @glasspot/backend db:migrate",
    "db:studio": "pnpm --filter @glasspot/backend db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
