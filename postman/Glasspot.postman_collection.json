            "description": "Admin-only, idempotent per Idempotency-Key. destinationAccount/destinationBank are ONLY required (and only used) for payoutMode='manual' pots — omit the body entirely for target_based/recurring/rotation pots, whose destination is already fixed in payoutConfig.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinationAccount\": \"{{destinationAccount}}\",\n  \"destinationBank\": \"{{destinationBank}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
