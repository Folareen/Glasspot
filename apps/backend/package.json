{
  "name": "@glasspot/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:worker": "tsx watch --env-file=.env src/workers/worker.ts",
    "start:worker": "node dist/workers/worker.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:prod": "tsc && tsc-alias --resolve-full-extension .js",
    "start:prod": "node dist/server.js",
    "start": "tsx --env-file=.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cross-env DB_MIGRATING=true tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@bull-board/api": "^8.1.0",
    "@bull-board/fastify": "^8.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "bullmq": "^5.79.2",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.6.1",
    "fastify-plugin": "^6.0.0",
    "fastify-zod": "^1.4.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "typed-rpc": "^6.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^8.0.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  }
}
