PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
DB_HOST=localhost
DB_USER=user
DB_PASSWORD=supersecret
DB_NAME=glasspot
DB_PORT=5433
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
REFRESH_TOKEN_SECRET=supersecret
JWT_SECRET=supersecret
NOMBA_ENVIRONMENT=sandbox
NOMBA_CLIENT_ID=your_client_id
NOMBA_CLIENT_SECRET=your_client_secret
NOMBA_ACCOUNT_ID=your_account_id
NOMBA_SUBACCOUNT_ID=your_subaccount_id
NOMBA_WEBHOOK_SECRET=your_webhook_secret
# Placeholder — replace with Nomba's actual documented /transfer rate limit before going live
NOMBA_TRANSFER_RATE_LIMIT_MAX=10
NOMBA_TRANSFER_RATE_LIMIT_DURATION_MS=1000
REDIS_URL=redis://localhost:6389
REDIS_PORT=6389
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=Glasspot <no-reply@glasspot.app>
BULL_BOARD_ENABLED=true
# Comma-separated user ids allowed to POST /banks/refresh (force-refresh the cached bank list)
BANKS_REFRESH_ALLOWED_USER_IDS=