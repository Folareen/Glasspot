{
  "name": "@glasspot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:worker": "tsx watch --env-file=../../.env src/workers/worker.ts",
    "start:worker": "node dist/workers/worker.js",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "tsx --env-file=../../.env src/server.ts",
    "reconcile": "tsx --env-file=../../.env src/scripts/run-reconciliation.ts",
    "expire-contributions": "tsx --env-file=../../.env src/scripts/expire-contributions.ts",
    "fire-payouts": "tsx --env-file=../../.env src/scripts/fire-payouts.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@glasspot/db": "workspace:*",
    "bullmq": "^5.79.2",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.6.1",
    "fastify-plugin": "^6.0.0",
    "fastify-zod": "^1.4.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.3",
    "typed-rpc": "^6.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  }
}
